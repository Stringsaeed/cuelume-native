{
  "name": "cuelume-native",
  "version": "0.1.0",
  "description": "Curated interaction sounds for React Native & Expo — synthesized live with react-native-audio-api, zero audio files, zero bundled runtime dependencies.",
  "keywords": [
    "react-native",
    "expo",
    "audio",
    "sound",
    "ui-sounds",
    "sound-effects",
    "interaction-feedback",
    "interface-sounds",
    "hover",
    "click",
    "synthesis"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Muhammed Ibrahim",
  "contributors": [
    "Daniel Belyi (original cuelume author, https://github.com/Danilaa1/cuelume)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stringsaeed/cuelume-native.git"
  },
  "bugs": {
    "url": "https://github.com/Stringsaeed/cuelume-native/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --experimental-test-module-mocks --test test/runtime.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-audio-api": ">=0.12.0",
    "react-native-worklets": ">=0.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-audio-api": "^0.13.3",
    "react-native-worklets": "^0.12.2",
    "typescript": "^5.6.0"
  }
}
